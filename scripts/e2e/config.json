{
  "endpoints": [
    {
      "name": "AI Gateway Health",
      "url": "http://localhost:5000/ai/health",
      "required": true
    },
    {
      "name": "AI Direct Health",
      "url": "http://localhost:5091/health",
      "required": true
    },
    {
      "name": "Identity Service Health",
      "url": "http://localhost:5057/health",
      "required": true
    },
    {
      "name": "Fleet Vehicles (gateway)",
      "url": "http://localhost:5000/fleet/Vehicles",
      "required": true,
      "auth": true
    },
    {
      "name": "AI vehicle fuel capacity",
      "url": "http://localhost:5000/ai/AiAssistant/chat",
      "method": "POST",
      "body": {
        "message": "What is the fuel capacity of MH01AB1005?"
      },
      "expectContains": "350",
      "timeoutSec": 180,
      "required": true,
      "auth": true
    },
    {
      "name": "AI vehicle maintenance history",
      "url": "http://localhost:5000/ai/AiAssistant/chat",
      "method": "POST",
      "body": {
        "message": "What maintenance work has been done on MH01AB1005?"
      },
      "expectContains": "Brake Inspection",
      "timeoutSec": 180,
      "required": true,
      "auth": true
    },
    {
      "name": "AI vehicle fuel history",
      "url": "http://localhost:5000/ai/AiAssistant/chat",
      "method": "POST",
      "body": {
        "message": "Show the fuel history for MH01AB1005."
      },
      "expectContains": "120.5",
      "timeoutSec": 180,
      "required": true,
      "auth": true
    },
    {
      "name": "AI unknown vehicle registration",
      "url": "http://localhost:5000/ai/AiAssistant/chat",
      "method": "POST",
      "body": {
        "message": "What is the fuel capacity of MH99ZZ9999?"
      },
      "expectContains": "no matching vehicle",
      "timeoutSec": 180,
      "required": true,
      "auth": true
    }
  ]
  ,
  "auth": {
    "tokenUrl": "http://localhost:5057/api/Auth/login",
    "email": "",
    "password": "",
    "headerName": "Authorization",
    "headerPrefix": "Bearer "
  }
}
